{
  "job": {
    "title": "WoW EU PvP Horde - five-minute cloud check",
    "url": "https://api.github.com/repos/maboeckmann/wow-horde-monitor/actions/workflows/monitor.yml/dispatches",
    "enabled": false,
    "saveResponses": true,
    "requestMethod": 1,
    "requestTimeout": 30,
    "redirectSuccess": false,
    "schedule": {
      "timezone": "Europe/Berlin",
      "expiresAt": 0,
      "hours": [-1],
      "mdays": [-1],
      "minutes": [0, 5, 10, 15, 20, 25, 30, 35, 40, 45, 50, 55],
      "months": [-1],
      "wdays": [-1]
    },
    "notification": {
      "onFailure": true,
      "onFailureCount": 1,
      "onSuccess": true,
      "onDisable": true,
      "mode": 2,
      "selectedChannels": [0]
    },
    "extendedData": {
      "headers": {
        "Accept": "application/vnd.github+json",
        "Authorization": "Bearer REPLACE_IN_CRON_JOB_CONSOLE_ONLY",
        "Content-Type": "application/json",
        "X-GitHub-Api-Version": "2026-03-10"
      },
      "body": "{\"ref\":\"main\",\"inputs\":{\"test_push\":false}}"
    }
  }
}
